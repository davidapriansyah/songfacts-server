generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("SUPABASE_URL")
  directUrl = env("SUPABASE_DIRECT_URL")
}

model User {
  id           Int         @id @default(autoincrement())
  email        String      @unique
  password     String?
  profileImage String?
  googleId     String?     @unique
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  favorites    Favorite[]
  userRecommendation UserRecommendation?
}

model Song {
  id          Int        @id @default(autoincrement())
  youtubeId   String?
  title       String
  artist      String
  album       String?
  albumCover  String?
  duration    Int?
  genres      String[]
  lyrics      String?    @db.Text
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  favorites   Favorite[]
  songFact    SongFact?
  songRecommendation SongRecommendation?
}

model Band {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  image       String?
  formedYear  Int?
  genres      String[]
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Favorite {
  id        Int      @id @default(autoincrement())
  userId    Int
  songId    Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  song      Song     @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@unique([userId, songId])
  @@map("Favorites")
}

model SongFact {
  id          Int      @id @default(autoincrement())
  songId      Int      @unique
  funFacts    Json
  generatedAt DateTime @default(now())
  song        Song     @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@map("SongFacts")
}

model SongRecommendation {
  id              Int      @id @default(autoincrement())
  songId          Int      @unique
  recommendations Json
  generatedAt     DateTime @default(now())
  song            Song     @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@map("SongRecommendations")
}

model UserRecommendation {
  id              Int      @id @default(autoincrement())
  userId          Int      @unique
  songs           Json
  source          String
  generatedAt     DateTime @default(now())
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("UserRecommendations")
}
